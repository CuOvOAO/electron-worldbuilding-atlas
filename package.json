{
  "name": "manuscript-atlas",
  "version": "0.0.1",
  "private": true,
  "description": "V0 clickable desktop prototype for Manuscript Atlas.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "package": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@types/archiver": "^8.0.0",
    "@types/yauzl": "^3.4.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@xyflow/react": "^12.11.0",
    "archiver": "^8.0.0",
    "d3-force": "^3.0.0",
    "electron-vite": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^7.0.0",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "electron": "^37.0.0",
    "electron-builder": "^26.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.0"
  },
  "build": {
    "appId": "local.manuscript-atlas.prototype",
    "productName": "手稿星图 Manuscript Atlas",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
